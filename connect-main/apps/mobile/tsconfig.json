{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "paths": {
      "react-native": ["./src/types/react-native.d.ts"]
    }
  },
  "include": ["src/**/*", "App.tsx"]
}
