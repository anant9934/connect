# ==============================================================================
# TATHASTU CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env OR .env.local FOR LOCAL DEVELOPMENT.
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR CERTIFICATES INTO VERSION CONTROL.
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
# Options: development | staging | production
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# --- DATABASE CONFIGURATION (PostgreSQL) ---
# Format: postgres://username:password@host:port/dbname?sslmode=disable
# In production, sslmode=verify-full or require is mandatory.
DATABASE_URL=postgres://connect_app:connect_dev_password@localhost:5432/connect_db?sslmode=disable
# Only when WORKER_ENABLED=true, or for cmd/worker. Must log in as connect_worker; never falls back to DATABASE_URL.
# WORKER_DATABASE_URL=postgres://connect_worker:password@localhost:5432/connect_db?sslmode=disable
# WORKER_DB_MAX_OPEN_CONNS=5
# WORKER_DB_MAX_IDLE_CONNS=1
# Administrative tools only. Never set this on an API or worker service; production refuses to start with it.
# MIGRATION_DATABASE_URL=postgres://migration_role:password@localhost:5432/connect_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300

# --- REDIS CONFIGURATION ---
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0
REDIS_TLS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# --- SECURITY & CORS ---
# Comma-separated list of allowed origins. Never use '*' in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Canonical public frontend origin (used for invite URLs and cookie security scope)
PUBLIC_APP_ORIGIN=http://localhost:3000

# --- LIVEKIT REALTIME SFU (Phase 2 integration boundary) ---
# Kept separated from application data plane
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey_placeholder_change_in_production
LIVEKIT_API_SECRET=devsecret_placeholder_change_in_production

# --- AI TATHASTU FEDERATION BOUNDARY ---
# Shared public key (or JWKS URL) for validating signed OIDC/context assertions
TATHASTU_INTEGRATION_ENABLED=true
TATHASTU_ISSUER=https://auth.aitathastu.internal
TATHASTU_AUDIENCE=tathastu-connect-service

# --- OBJECT STORAGE (Cloudflare R2 / AWS S3) ---
STORAGE_PROVIDER=local
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=tathastu-connect-files
R2_ACCESS_KEY_ID=r2_token_access_key_placeholder
R2_SECRET_ACCESS_KEY=r2_token_secret_key_placeholder
R2_REGION=auto

# --- MALWARE SCANNING (ClamAV TCP Daemon) ---
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- FRONTEND CLIENT ENVIRONMENT (apps/web) ---
# ONLY variables prefixed with NEXT_PUBLIC_ are accessible in the browser bundle.
# NEVER place secrets, private keys, or internal database URLs here.
NEXT_PUBLIC_APP_ENV=development
# Canonical public frontend origin for meeting invites & metadata
NEXT_PUBLIC_APP_ORIGIN=https://connect-alpha-seven.vercel.app
# Internal backend URL for Next.js same-origin API proxy rewrites
INTERNAL_API_URL=http://localhost:8080
# Leave NEXT_PUBLIC_API_URL empty in production to leverage same-origin proxy
NEXT_PUBLIC_API_URL=

